{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "phase",
    "rotationRevision",
    "activeKey",
    "acceptedKeys",
    "secretRefs",
    "image",
    "service"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "rotationRevision": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "activeKey": {
      "type": "string",
      "pattern": "^g[0-9]+$"
    },
    "acceptedKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^g[0-9]+$"
      }
    },
    "secretRefs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "key"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  },
  "additionalProperties": false
}
